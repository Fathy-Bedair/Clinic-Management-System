@model Patient

@{
    ViewData["Title"] = "Edit Patient";
    Layout = "_AdminLayout";
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Edit Patient Details</h1>
    <a asp-area="Admin" asp-controller="Patients" asp-action="Index" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Update Patient Information</h6>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Patients" asp-action="Edit" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- الحقل المخفي مهم جداً لعملية التحديث -->
                    <input type="hidden" asp-for="Id" />

                    <!-- Full Name -->
                    <div class="form-group">
                        <label asp-for="Name" class="control-label font-weight-bold">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Date of Birth & Gender -->
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="DateOfBirth" class="control-label font-weight-bold">Date of Birth <span class="text-danger">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="Gender" class="control-label font-weight-bold">Gender <span class="text-danger">*</span></label>
                            <!-- بافتراض إن Gender عبارة عن Enum -->
                            <select asp-for="Gender" class="form-control" asp-items="Html.GetEnumSelectList<PGender>()">
                                <option value="">-- Select Gender --</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Blood Type & Emergency Contact -->
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="BloodType" class="control-label font-weight-bold">Blood Type</label>
                            <select asp-for="BloodType" class="form-control">
                                <option value="">-- Unknown --</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                            <span asp-validation-for="BloodType" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="PhoneNumber" class="control-label font-weight-bold">Emergency Contact</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Optional" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- System Account ID -->
                    @*<div class="form-group">
                        <label asp-for="UserId" class="control-label font-weight-bold">System Account ID</label>
                        <input asp-for="UserId" class="form-control" readonly />
                        <span asp-validation-for="UserId" class="text-danger small"></span>
                        <small class="form-text text-muted">Account ID is linked to identity and cannot be edited directly.</small>
                    </div>*@

                    <hr />

                    <!-- Action Buttons -->
                    <div class="form-group mb-0">
                        <button type="submit" class="btn btn-warning px-4 text-dark font-weight-bold shadow-sm">
                            <i class="fas fa-sync-alt mr-1"></i> Update Patient
                        </button>
                        <a asp-area="Admin" asp-controller="Patients" asp-action="Index" class="btn btn-light border shadow-sm">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}