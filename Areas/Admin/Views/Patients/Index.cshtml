@model IEnumerable<Patient>

@{
    ViewData["Title"] = "Manage Patients";
    Layout = "_AdminLayout";
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Patients Directory</h1>
</div>

<!-- Patients Table -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-users mr-1"></i> Registered Patients</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>Patient Name</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th class="text-center">Blood Type</th>
                        <th>Emergency Contact</th>
                        <th class="text-center" style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold text-primary">@item.Name</td>
                                <td>@item.DateOfBirth.ToString("dd MMM yyyy")</td>
                                <td>@item.Gender.ToString()</td>
                                <td class="text-center">
                                    <span class="badge badge-info px-2 py-1">@(item.BloodType ?? "N/A")</span>
                                </td>
                                <td>@(item.PhoneNumber ?? "Not Provided")</td>
                                <td class="text-center">
                                    <!-- Details Button -->
                                    <a asp-area="Admin" asp-controller="Patients" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-circle btn-sm shadow-sm" title="View Details">
                                        <i class="fas fa-list-alt"></i>
                                    </a>
                                    <!-- Edit Button -->
                                    <a asp-area="Admin" asp-controller="Patients" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-circle btn-sm shadow-sm" title="Edit Patient">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <!-- Delete Button -->
                                    <a asp-area="Admin" asp-controller="Patients" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-circle btn-sm shadow-sm" title="Delete Patient">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No patients registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                "order": [[0, "asc"]] // ترتيب أبجدي باسم المريض كافتراضي
            });
        });
    </script>
}