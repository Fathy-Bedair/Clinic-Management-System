@model Patient

@{
    ViewData["Title"] = "Patient Details";
    Layout = "_AdminLayout";
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Patient Details</h1>
    <a asp-area="Admin" asp-controller="Patients" asp-action="Index" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-8">

        <!-- ========================================== -->
        <!-- الكارت الأول: البيانات الأساسية للمريض -->
        <!-- ========================================== -->
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-user-injured mr-2"></i> @Model.Name
                </h6>
            </div>
            <div class="card-body">

                <!-- Date of Birth -->
                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">Date of Birth:</div>
                    <div class="col-sm-8 text-gray-600">
                        <i class="fas fa-birthday-cake fa-sm text-muted mr-1"></i> @Model.DateOfBirth.ToString("dd MMMM yyyy")
                    </div>
                </div>
                <hr />

                <!-- Gender -->
                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">Gender:</div>
                    <div class="col-sm-8 text-gray-600">
                        @if (Model.Gender.ToString() == "Male")
                        {
                            <i class="fas fa-mars text-primary mr-1"></i>
                        }
                        else if (Model.Gender.ToString() == "Female")
                        {
                            <i class="fas fa-venus text-danger mr-1"></i>
                        }
                        @Model.Gender.ToString()
                    </div>
                </div>
                <hr />

                <!-- Blood Type -->
                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">Blood Type:</div>
                    <div class="col-sm-8 text-gray-600">
                        <span class="badge badge-danger px-2 py-1">@(Model.BloodType ?? "Unknown")</span>
                    </div>
                </div>
                <hr />

                <!-- Emergency Contact -->
                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">Emergency Contact:</div>
                    <div class="col-sm-8 text-gray-600">
                        <i class="fas fa-phone-alt fa-sm text-muted mr-1"></i> @(Model.PhoneNumber ?? "Not Provided")
                    </div>
                </div>
                <hr />

                <!-- System Account ID -->
                @* <div class="row mb-4 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">System Account ID:</div>
                    <div class="col-sm-8">
                        <code class="text-muted">@Model.UserId</code>
                    </div>
                </div> *@

                <!-- Action Buttons -->
                <div class="text-center mt-4 pt-2">
                    <a asp-area="Admin" asp-controller="Patients" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 font-weight-bold text-dark shadow-sm mr-2">
                        <i class="fas fa-edit mr-1"></i> Edit Details
                    </a>
                    <a asp-area="Admin" asp-controller="Patients" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger px-4 font-weight-bold shadow-sm">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </a>
                </div>

            </div>
        </div>
        <!-- نهاية الكارت الأول -->
        <!-- ========================================== -->
        <!-- الكارت الثاني: السجل الطبي -->
        <!-- ========================================== -->
        <div class="card shadow mb-4 mt-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-notes-medical mr-2"></i> Medical History
                </h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-sm" width="100%" cellspacing="0">
                        <thead class="thead-light">
                            <tr>
                                <th>Date</th>
                                <th>Doctor</th>
                                <th>Diagnosis</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Appointments != null && Model.Appointments.Any(a => a.MedicalRecord != null))
                            {
                                foreach (var appointment in Model.Appointments.Where(a => a.MedicalRecord != null).OrderByDescending(a => a.AppointmentDate))
                                {
                                    <tr>
                                        <td>@appointment.AppointmentDate.ToString("dd MMM yyyy")</td>
                                        <td>Dr. @appointment.Doctor?.Name</td>
                                        <td>@appointment.MedicalRecord.Diagnosis</td>
                                        <td class="text-center">
                                            <a asp-area="Admin" asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@appointment.MedicalRecord.Id" class="btn btn-primary btn-sm shadow-sm">
                                                View Prescription
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No medical records available for this patient.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- نهاية الكارت الثاني -->

    </div>
</div>