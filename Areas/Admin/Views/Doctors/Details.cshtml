@model Doctor

@{
    ViewData["Title"] = "Doctor Details";
    Layout = "_AdminLayout";
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Doctor Details</h1>
    <a asp-area="Admin" asp-controller="Doctors" asp-action="Index" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Doctor Details Card -->
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-user-md mr-2"></i> Dr. @Model.Name
                </h6>
                @if (Model.IsActive)
                {
                    <span class="badge badge-success px-3 py-2">Active</span>
                }
                else
                {
                    <span class="badge badge-danger px-3 py-2">Inactive</span>
                }
            </div>
            <div class="card-body">

                <!-- Specialization -->
                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">Specialization:</div>
                    <div class="col-sm-8 text-gray-600">
                        <span class="badge badge-info px-2 py-1">
                            @(Model.Specialization?.Name ?? "Not Assigned")
                        </span>
                    </div>
                </div>
                <hr />

                <!-- Phone Number -->
                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">Phone Number:</div>
                    <div class="col-sm-8 text-gray-600">
                        <i class="fas fa-phone-alt fa-sm text-muted mr-1"></i> @Model.PhoneNumber
                    </div>
                </div>
                <hr />

                <!-- Years of Experience -->
                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">Years of Experience:</div>
                    <div class="col-sm-8 text-gray-600">
                        @Model.YearsOfExperience Years
                    </div>
                </div>
                <hr />

                <!-- Consultation Fee -->
                <div class="row mb-3 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">Consultation Fee:</div>
                    <div class="col-sm-8 text-success font-weight-bold">
                        @Model.ConsultationFee EGP
                    </div>
                </div>
                <hr />

                <!-- Linked Account ID (ASP.NET Core Identity) -->
                @* <div class="row mb-4 align-items-center">
                    <div class="col-sm-4 font-weight-bold text-gray-800">System Account ID:</div>
                    <div class="col-sm-8">
                        <code class="text-muted">@Model.UserId</code>
                    </div>
                </div> *@

                <!-- Action Buttons -->
                <div class="text-center mt-4 pt-2">
                    <a asp-area="Admin" asp-controller="Doctors" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 font-weight-bold text-dark shadow-sm mr-2">
                        <i class="fas fa-edit mr-1"></i> Edit Details
                    </a>
                    <a asp-area="Admin" asp-controller="Doctors" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger px-4 font-weight-bold shadow-sm">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>